{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}

<h2 class="page-title">Mon Profil</h2>

<form method="post" class="profile-form">

    <div class="form-group">
        <label>Prénom</label>
        <input type="text" name="prenom" value="{{ app.user.prenom }}">
    </div>

    <div class="form-group">
        <label>Nom</label>
        <input type="text" name="nom" value="{{ app.user.nom }}">
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" value="{{ app.user.email }}">
    </div>

    <button type="submit" class="profile-btn">
        Mettre à jour
    </button>

</form>

{% endblock %}