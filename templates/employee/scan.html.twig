{% extends 'base.html.twig' %}

{% block title %}Scanner QR{% endblock %}

{% block body %}

<div class="scan-container">

    <h2 class="scan-title">Scanner une réservation</h2>

    <div class="scan-card">
        <div id="reader"></div>

        <div id="scan-result"></div>
    </div>

</div>

<script src="https://unpkg.com/html5-qrcode"></script>

<script>

function onScanSuccess(decodedText) {

    fetch("/admin/validateqr/" + decodedText)
        .then(response => response.json())
        .then(data => {

            let result = document.getElementById("scan-result");

            result.innerHTML = data.message;

            if(data.message.includes("validée")){
                result.className = "scan-result scan-success";
            } else {
                result.className = "scan-result scan-error";
            }

        });

}

let scanner = new Html5QrcodeScanner(
    "reader",
    {
        fps: 10,
        qrbox: 250
    }
);

scanner.render(onScanSuccess);

</script>

{% endblock %}