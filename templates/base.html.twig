<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">

    <title>{% block title %}CROUS{% endblock %}</title>

    <link rel="icon" type="image/png" href="{{ asset('favicon.png') }}">
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">

    {{ importmap('app') }}
</head>

<body>

    {% include 'partials/_header.html.twig' %}

    <main class="page-content">
        <div class="page-wrapper">
            <div class="page-card">

                {% for message in app.flashes('error') %}
                    <div class="flash-message flash-error">
                        {{ message }}
                    </div>
                {% endfor %}

                {% for message in app.flashes('success') %}
                    <div class="flash-message flash-success">
                        {{ message }}
                    </div>
                {% endfor %}

                {% block body %}{% endblock %}

            </div>
        </div>
    </main>
    
    {% if app.user %}
        {% set totalItems = 0 %}
        {% for item in app.session.get('panier', []) %}
            {% set totalItems = totalItems + item.quantity %}
        {% endfor %}

        
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('panier') }}" class="cart-fab">

                <svg viewBox="0 0 24 24">
                    <path d="M3 3h2l2 12h11l2-9H6"
                        stroke="#ffffff"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        fill="none"/>

                    <circle cx="9" cy="20" r="1.6" fill="#ffffff"/>
                    <circle cx="18" cy="20" r="1.6" fill="#ffffff"/>
                </svg>

                {% if totalItems > 0 %}
                    <span class="cart-badge">{{ totalItems }}</span>
                {% endif %}

            </a>
        {% endif %}
    {% endif %}

    {% include 'partials/_footer.html.twig' %}

</body>
</html>